# Copy to .env on the server (or set these in the Hostinger Node.js app settings).
#
# This is the shoaibecomerce.com ads landing page (one 'm'). Every secret below
# must be NEW — never reuse the values from the main shoaibecommerce.com site.

# Canonical origin. Feeds canonical tags, Open Graph, and schema.org.
# Leave unset to fall back to https://shoaibecomerce.com (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://shoaibecomerce.com

# Admin dashboard login password — pick a strong one (letters and digits only).
# Without it, /admin stays locked. Must differ from the main site's password.
ADMIN_PASSWORD=

# Signs login sessions and encrypts the 2FA secret. Set once to a long random
# string (40+ chars) and NEVER change it — changing it logs everyone out and
# forces the authenticator app to be set up again.
# Generate a fresh one for this site; do NOT copy the main site's value.
AUTH_SECRET=

# Hostinger MySQL database (hPanel -> Databases -> MySQL Databases).
# This site needs its OWN database — do not point it at the main site's DB.
# Use the full prefixed names shown in hPanel. Keep the password letters+digits only.
# If these are missing, content edits are stored in a local .data/content.json
# file instead — fine for local dev, NOT for production (redeploys can wipe it).
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
